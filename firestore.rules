rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, create, update: if owns(uid);
      match /studyEntries/{entryId} {
        allow read, create, update: if owns(uid);
      }
    }
  }
}
